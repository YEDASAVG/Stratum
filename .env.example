# Stratum Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED - Host Configuration
# ============================================

# Your server's IP or hostname (for remote deployments)
# This is used by the dashboard to connect to the API
# For local: localhost
# For remote: your-server-ip or your-domain.com
STRATUM_HOST=localhost

# ============================================
# REQUIRED - LLM Configuration
# ============================================

# LLM Provider: "groq" (cloud) or "ollama" (local)
# Use "ollama" for unlimited local inference (no rate limits!)
LLM_PROVIDER=groq

# ============================================
# Groq Configuration (when LLM_PROVIDER=groq)
# ============================================

# Get free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# Groq retires models regularly. List the ones your account can actually use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# Verified working on a free account (latency for a short log-analysis prompt):
#   - openai/gpt-oss-20b    (default) ~650ms
#   - qwen/qwen3.8-27b      ~170ms, more concise answers
#   - openai/gpt-oss-120b   ~920ms, more detail
#   - groq/compound-mini    ~1800ms, verbose
GROQ_MODEL=openai/gpt-oss-20b

# ============================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# ============================================

# Ollama server URL
# For Docker: use http://host.docker.internal:11434 to reach Ollama on your host machine
# For local dev: use http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434

# Ollama model to use (must be pulled first: ollama pull <model>)
# Popular options:
#   - llama3.2:3b (fast, lightweight)
#   - llama3.1:8b (good balance)
#   - mistral (fast, good quality)
#   - codellama (code-focused)
OLLAMA_MODEL=llama3.2:3b

# Max logs to display in chat responses (higher = more complete but slower)
# This is separate from the 100 logs fetched for semantic search
LOGAI_MAX_CONTEXT_LOGS=25

# ============================================
# OPTIONAL - Security
# ============================================

# API Key for authentication (leave empty to disable)
# When set, all API requests must include: X-API-Key: your-key
LOGAI_API_KEY=

# ============================================
# OPTIONAL - Infrastructure (defaults shown)
# ============================================

# API Server Port
PORT=3000

# NATS Message Queue
NATS_URL=localhost:4222

# Qdrant Vector Database
QDRANT_URL=http://localhost:6334

# ClickHouse Database
CLICKHOUSE_URL=http://localhost:8123

# ============================================
# OPTIONAL - Slack Alerts
# ============================================

# Slack webhook URL for anomaly alerts
# Get it from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ============================================
# OPTIONAL - Logging
# ============================================

# Log level: trace, debug, info, warn, error
RUST_LOG=info
